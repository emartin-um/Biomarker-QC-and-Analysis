# R/RStudio files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Data files - keep input/output out of version control (but keep .gitkeep)
**/input_files/**
**/output_files/**
**/output_files_*/**
!**/input_files/.gitkeep
!**/output_files/.gitkeep

# Backup files (kept on disk for provenance, not in version control)
*.bak
*.Rbak

# HTML output from Quarto/Rmd (regenerated from source)
*.html

# Quarto cache and output
*_files/
*_cache/
/.quarto/

# Mac system files
.DS_Store

# Temporary files
*~
*.tmp

# Logs (render logs, etc.)
*.log

# Generated plot files
Rplots.pdf

# Analysis output files (regenerated from source scripts)
**/*.csv
**/*.xlsx
**/*.rds

# Old/archived files
/old/

# Archived / backed-up run outputs (kept on disk for provenance, not in version control)
**/_archive*/
**/_backup*/

# Dataset-specific notes (not tracked - each dataset has its own)
notes.md
